    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
